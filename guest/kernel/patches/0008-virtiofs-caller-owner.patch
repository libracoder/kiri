+static int fuse_caller_setattr_check(struct mnt_idmap *idmap,
+				     struct fuse_conn *fc,
+				     struct iattr *attr)
+{
+	unsigned int ia_valid = attr->ia_valid;
+	vfsuid_t caller_uid = make_vfsuid(idmap, fc->user_ns, current_fsuid());
+	vfsgid_t caller_gid = make_vfsgid(idmap, fc->user_ns, current_fsgid());
+
+	if ((ia_valid & ATTR_UID) &&
+	    !(vfsuid_eq_kuid(caller_uid, current_fsuid()) &&
+	      vfsuid_eq(attr->ia_vfsuid, caller_uid)) &&
+	    !fuse_caller_capable(fc, CAP_CHOWN))
+		return -EPERM;
+
+	if ((ia_valid & ATTR_GID) &&
+	    !(vfsuid_eq_kuid(caller_uid, current_fsuid()) &&
+	      (vfsgid_eq(attr->ia_vfsgid, caller_gid) ||
+	       vfsgid_in_group_p(attr->ia_vfsgid))) &&
+	    !fuse_caller_capable(fc, CAP_CHOWN))
+		return -EPERM;
+
+	if (ia_valid & ATTR_MODE) {
+		vfsgid_t vfsgid = (ia_valid & ATTR_GID) ?
+			attr->ia_vfsgid : caller_gid;
+
+		if (!vfsuid_eq_kuid(caller_uid, current_fsuid()) &&
+		    !fuse_caller_capable(fc, CAP_FOWNER))
+			return -EPERM;
+
+		if (!vfsgid_eq(vfsgid, caller_gid) &&
+		    !vfsgid_in_group_p(vfsgid) &&
+		    !(vfsgid_has_mapping(fc->user_ns, vfsgid) &&
+		      fuse_caller_capable(fc, CAP_FSETID)))
+			attr->ia_mode &= ~S_ISGID;
+	}
+
+	if ((ia_valid & (ATTR_MTIME_SET | ATTR_ATIME_SET | ATTR_TIMES_SET)) &&
+	    !vfsuid_eq_kuid(caller_uid, current_fsuid()) &&
+	    !fuse_caller_capable(fc, CAP_FOWNER))
+		return -EPERM;
+
+	attr->ia_valid |= ATTR_FORCE;
+	return 0;
+}
