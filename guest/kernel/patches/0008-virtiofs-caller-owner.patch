+static bool fuse_caller_capable(struct fuse_conn *fc, int cap)
+{
+	struct user_namespace *ns = fc->user_ns;
+
+	return kuid_has_mapping(ns, current_fsuid()) &&
+	       kgid_has_mapping(ns, current_fsgid()) &&
+	       ns_capable(ns, cap);
+}
+
+/*
+ * Apple's virtiofs server echoes InHeader.uid/gid as the file's owner, so
+ * every caller is treated as the owner there. Check owner mode bits and
+ * DAC capabilities directly instead of racing on cached inode->i_uid/i_gid
+ * from other callers.
+ */
+static int fuse_caller_permission(struct inode *inode, int mask)
+{
+	struct fuse_conn *fc = get_fuse_conn(inode);
+	umode_t mode = inode->i_mode;
+	int m = mask & (MAY_READ | MAY_WRITE | MAY_EXEC);
+
+	if (!(m & ~(mode >> 6)))
+		return 0;
+
+	if (S_ISDIR(mode)) {
+		if (!(m & MAY_WRITE) &&
+		    fuse_caller_capable(fc, CAP_DAC_READ_SEARCH))
+			return 0;
+		if (fuse_caller_capable(fc, CAP_DAC_OVERRIDE))
+			return 0;
+		return -EACCES;
+	}
+
+	if (m == MAY_READ && fuse_caller_capable(fc, CAP_DAC_READ_SEARCH))
+		return 0;
+
+	if ((!(m & MAY_EXEC) || (mode & S_IXUGO)) &&
+	    fuse_caller_capable(fc, CAP_DAC_OVERRIDE))
+		return 0;
+
+	return -EACCES;
+}
