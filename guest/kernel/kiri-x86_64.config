# Kiri guest kernel for Intel Macs: build.sh takes kiri.config without its Arm
# platform lines (CONFIG_ARM*, PL031, the generic PCI host) and adds these.
# Virtualization.framework on Intel boots the bzImage through the Linux x86
# boot protocol; CPUs and PCI come from ACPI (MP tables as a fallback).

# --- core -------------------------------------------------------------------
CONFIG_X86_64=y
# Virtualization.framework on Intel will not start a bzImage that is not
# relocatable: start fails with only "Internal Virtualization error". KASLR
# (RANDOMIZE_BASE) stays off; this only lets the kernel run where it is put.
CONFIG_RELOCATABLE=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_X86_X2APIC=y
CONFIG_X86_MPPARSE=y
CONFIG_ACPI=y
CONFIG_HPET_TIMER=y
# PCI config space through ACPI's MCFG (ECAM) as well as the legacy ports.
CONFIG_PCI_MMCONFIG=y
# x86 always boots a self-decompressing bzImage (it has no uncompressed
# payload option); LZ4 unpacks fastest, a few ms, where gzip takes tens.
CONFIG_KERNEL_LZ4=y
