# socket diagnostics (ss, ss -K)
CONFIG_INET_DIAG=y
CONFIG_INET_TCP_DIAG=y
CONFIG_INET_UDP_DIAG=y
CONFIG_INET_RAW_DIAG=y
CONFIG_INET_DIAG_DESTROY=y
CONFIG_UNIX_DIAG=y
CONFIG_PACKET_DIAG=y
CONFIG_NETLINK_DIAG=y

# interfaces and tunnels: macvlan/ipvlan networks, VLANs, WireGuard, IPsec.
# Not PF_KEY (NET_KEY, IPsec's old interface; ip xfrm uses XFRM_USER) or
# the route4 classifier: rarely used, and both have had privilege bugs.
CONFIG_MACVLAN=y
CONFIG_IPVLAN=y
CONFIG_VLAN_8021Q=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_NET_L3_MASTER_DEV=y
CONFIG_NET_VRF=y
CONFIG_BONDING=y
CONFIG_WIREGUARD=y
CONFIG_GENEVE=y
CONFIG_NET_IPIP=y
CONFIG_NET_IPGRE_DEMUX=y
CONFIG_NET_IPGRE=y
CONFIG_IPV6_TUNNEL=y
CONFIG_IPV6_SIT=y
CONFIG_IPV6_GRE=y
CONFIG_XFRM_USER=y
CONFIG_XFRM_INTERFACE=y
CONFIG_INET_AH=y
CONFIG_INET_ESP=y
CONFIG_INET_IPCOMP=y
CONFIG_INET6_AH=y
CONFIG_INET6_ESP=y
CONFIG_INET6_IPCOMP=y

# --- eBPF tools: Cilium, bpftrace, Tetragon -----------------------------------
# With BPF_JIT above. Perf events carry the datapath's drop and trace events
# (bpf_perf_event_output); BPF_EVENTS follows from perf events plus kprobe
# events. BTF (/sys/kernel/btf/vmlinux) needs debug info and pahole at build
# time; the debug info itself is not in the Image. SHA1 is on Cilium's list;
# the IPsec options above select SHA256 only.
CONFIG_PERF_EVENTS=y
CONFIG_FTRACE=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_CRYPTO_SHA1=y
